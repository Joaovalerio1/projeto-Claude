{%- capture section_settings -%}
    {
    "autoPlay": {{ section.settings.autoplay | json }},
    "prevNextButtons": false,
    "pageDots": {% if section.blocks.size > 1 %}true{% else %}false{% endif %},
    "setGallerySize": {% if section.settings.section_size == 'preserve_ratio' %}true{% else %}false{% endif %},
    "adaptiveHeight": {% if section.settings.section_size == 'preserve_ratio' %}true{% else %}false{% endif %},
    "transitionEffect": {{ section.settings.carousel_effect | json }},
    "cycleSpeed": {{ section.settings.cycle_speed | times: 1000 | json }}
    }
{%- endcapture -%}

<section data-section-id="{{ section.id }}" data-section-type="slideshow" data-section-settings='{{ section_settings }}'>
    <div {% unless section.settings.edge_to_edge %}class="container container--flush"{% endunless %}>
        <div class="slideshow slideshow--{{ section.settings.section_size | replace: '_', '-' }} {% if section.settings.edge_to_edge %}slideshow--edge2edge{% endif %}"
             style="color: {{ section.blocks.first.settings.text_color }}">
            {%- assign section_has_video = false -%}
            {%- for block in section.blocks -%}
                {%- comment -%}
                    Mídia do banner: quando "Vídeo" estiver selecionado e houver um vídeo válido,
                    o vídeo substitui a imagem. Em qualquer outro caso o slide funciona como antes.
                {%- endcomment -%}
                {%- assign use_video = false -%}
                {%- assign eager_media = false -%}
                {%- if section.settings.removeLazyLoad and forloop.index == 1 -%}
                    {%- assign eager_media = true -%}
                {%- endif -%}

                {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
                    {%- comment -%} Desktop: melhor MP4 com lado menor até 1080px {%- endcomment -%}
                    {%- assign video_src_desktop = '' -%}
                    {%- assign best_side = 0 -%}
                    {%- assign smallest_side = 100000 -%}
                    {%- assign smallest_src = '' -%}
                    {%- for source in block.settings.video.sources -%}
                        {%- if source.format == 'mp4' -%}
                            {%- assign short_side = source.width | at_most: source.height -%}
                            {%- if short_side <= 1080 and short_side > best_side -%}
                                {%- assign best_side = short_side -%}
                                {%- assign video_src_desktop = source.url -%}
                            {%- endif -%}
                            {%- if short_side < smallest_side -%}
                                {%- assign smallest_side = short_side -%}
                                {%- assign smallest_src = source.url -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                    {%- if video_src_desktop == blank -%}
                        {%- assign video_src_desktop = smallest_src -%}
                    {%- endif -%}

                    {%- comment -%} Celular: vídeo de celular (ou o de desktop) com lado menor até 720px {%- endcomment -%}
                    {%- assign phone_video = block.settings.mobile_video | default: block.settings.video -%}
                    {%- assign video_src_phone = '' -%}
                    {%- assign best_side = 0 -%}
                    {%- assign smallest_side = 100000 -%}
                    {%- assign smallest_src = '' -%}
                    {%- for source in phone_video.sources -%}
                        {%- if source.format == 'mp4' -%}
                            {%- assign short_side = source.width | at_most: source.height -%}
                            {%- if short_side <= 720 and short_side > best_side -%}
                                {%- assign best_side = short_side -%}
                                {%- assign video_src_phone = source.url -%}
                            {%- endif -%}
                            {%- if short_side < smallest_side -%}
                                {%- assign smallest_side = short_side -%}
                                {%- assign smallest_src = source.url -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                    {%- if video_src_phone == blank -%}
                        {%- assign video_src_phone = smallest_src | default: video_src_desktop -%}
                    {%- endif -%}

                    {%- if video_src_desktop != blank -%}
                        {%- assign use_video = true -%}
                        {%- assign section_has_video = true -%}
                        {%- assign video_ratio_desktop = block.settings.video.aspect_ratio | default: 1.7778 -%}
                        {%- assign video_ratio_phone = phone_video.aspect_ratio | default: video_ratio_desktop -%}
                        {%- assign video_fallback = block.settings.video_fallback_image | default: block.settings.video.preview_image -%}
                    {%- endif -%}
                {%- endif -%}

                {%- if block.settings.mobile_image -%}
                    {%- capture mobile_size -%}{{ block.settings.mobile_image.width | at_most: 600 }}x{{ block.settings.mobile_image.height | at_most: 800 }}{%- endcapture -%}
                    {%- capture bgset -%}{{ block.settings.mobile_image | img_url: mobile_size, crop: 'center' }} [--phone] | {{ block.settings.image | img_url: '800x' }} 800w, {{ block.settings.image | img_url: '1000x' }} 1000w, {{ block.settings.image | img_url: '1200x' }} 1200w, {{ block.settings.image | img_url: '1400x' }} 1400w, {{ block.settings.image | img_url: '1600x' }} 1600w, {{ block.settings.image | img_url: '1800x' }} 1800w{%- endcapture -%}
                {%- else -%}
                    {%- capture mobile_size -%}{{ block.settings.image.width | at_most: 600 }}x{{ block.settings.image.height | at_most: 800 }}{%- endcapture -%}
                    {%- capture bgset -%}{{ block.settings.image | img_url: mobile_size, crop: 'center' }} [--phone] | {{ block.settings.image | img_url: '800x' }} 800w, {{ block.settings.image | img_url: '1000x' }} 1000w, {{ block.settings.image | img_url: '1200x' }} 1200w, {{ block.settings.image | img_url: '1400x' }} 1400w, {{ block.settings.image | img_url: '1600x' }} 1600w, {{ block.settings.image | img_url: '1800x' }} 1800w{%- endcapture -%}
                {%- endif -%}

                {%- capture slide_inner -%}
                    <div class="slideshow__slide-inner slideshow__slide-inner--{{ block.settings.content_position | replace: '_', '-' }} lazyload image--fade-in"
                         {% if block.settings.image and section.settings.section_size != 'preserve_ratio' and use_video == false %}data-bgset="{{ bgset }}"
                         data-sizes="auto"{% endif %}>
                        {%- unless block.settings.image or use_video -%}
                            {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}

                            {%- if section.settings.section_size == 'preserve_ratio' -%}
                                {{- placeholder | placeholder_svg_tag: 'slideshow__image-placeholder' -}}
                            {%- else -%}
                                <div class="slideshow__placeholder">
                                    {{- placeholder | placeholder_svg_tag: 'slideshow__image-placeholder' -}}
                                </div>
                            {%- endif -%}
                        {%- endunless -%}

                        {%- if block.settings.image and section.settings.section_size == 'preserve_ratio' and use_video == false -%}
                            {%- capture supported_sizes -%}{%- render 'image-size', sizes: '800,900,1000,1100,1200,1300,1400,1600,1800,2000,2200', image: block.settings.image -%}{%- endcapture -%}
                            {%- assign image_url = block.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

                            <div class="aspect-ratio {% if block.settings.mobile_image %}hidden-phone{% endif %}"
                                 style="padding-bottom: {{ 100.0 | divided_by: block.settings.image.aspect_ratio }}%">
<picture>
  <source media="(min-width:640px)" {% unless section.settings.removeLazyLoad and forloop.index == 1 %}data-{% endunless %}srcset="{{ block.settings.image | img_url: '1800x' }}">
  <img class="slideshow__image {% if section.settings.removeLazyLoad and forloop.index == 1 %}removelazyload{% else %}lazyload image--fade-in{% endif %}"
       {% if section.settings.removeLazyLoad and forloop.index == 1 %}
        loading="eager"
       {% else %}
        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        loading="lazy"
       {% endif %}
       alt="{{ block.settings.image.alt | escape }}" width="100%" height="100%"/>
</picture>
{% comment %}
                                <img class="slideshow__image lazyload image--fade-in"
                                     alt="{{ block.settings.image.alt | escape }}" data-src="{{ image_url }}"
                                     data-widths="[{{ supported_sizes }}]" data-sizes="auto">
                                <noscript>
                                    <img src="{{ block.settings.image | img_url: '1200x' }}"
                                         alt="{{ block.settings.image.alt | escape }}">
                                </noscript>
{% endcomment %}
                            </div>

                            {%- if block.settings.mobile_image -%}
                                {%- capture supported_sizes -%}{%- render 'image-size', sizes: '600,700,800,900,1000,1100,1200', image: block.settings.mobile_image -%}{%- endcapture -%}
                                {%- assign image_url = block.settings.mobile_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

                                <div class="aspect-ratio hidden-tablet-and-up"
                                     style="padding-bottom: {{ 100.0 | divided_by: block.settings.mobile_image.aspect_ratio }}%">
<picture>
  <source media="(max-width:640px)" {% unless section.settings.removeLazyLoad and forloop.index == 1 %}data-{% endunless %}srcset="{{ block.settings.mobile_image | img_url: '900x' }}">
  <img class="slideshow__image {% if section.settings.removeLazyLoad and forloop.index == 1 %}removelazyload{% else %}lazyload image--fade-in{% endif %}"
       {% if section.settings.removeLazyLoad and forloop.index == 1 %}
        loading="eager"
       {% else %}
        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        loading="lazy"
       {% endif %}
       alt="{{ block.settings.mobile_image.alt | escape }}" width="100%" height="100%"/>
</picture>
{% comment %}
                                    <img class="slideshow__image lazyload image--fade-in"
                                         alt="{{ block.settings.mobile_image.alt | escape }}" data-src="{{ image_url }}"
                                         data-widths="[{{ supported_sizes }}]" data-sizes="auto">

                                    <noscript>
                                        <img src="{{ block.settings.mobile_image | img_url: '800x' }}"
                                             alt="{{ block.settings.mobile_image.alt | escape }}">
                                    </noscript>
{% endcomment %}
                                </div>
                            {%- endif -%}
                        {%- endif -%}

                        {%- if use_video -%}
                            <div class="slideshow__video-wrapper {% if section.settings.section_size == 'preserve_ratio' %}aspect-ratio{% else %}slideshow__video-wrapper--fill{% endif %}">
                                {%- if video_fallback -%}
                                    <img class="slideshow__image slideshow__video-fallback"
                                         src="{{ video_fallback | image_url: width: 1800 }}"
                                         srcset="{{ video_fallback | image_url: width: 800 }} 800w, {{ video_fallback | image_url: width: 1200 }} 1200w, {{ video_fallback | image_url: width: 1800 }} 1800w"
                                         sizes="100vw"
                                         {% if eager_media %}loading="eager"{% else %}loading="lazy"{% endif %}
                                         alt="{{ video_fallback.alt | escape }}" width="100%" height="100%"/>
                                {%- endif -%}
                                <video class="slideshow__image slideshow__video"
                                       autoplay muted loop playsinline disablepictureinpicture disableremoteplayback
                                       preload="{% if eager_media %}auto{% else %}metadata{% endif %}"
                                       aria-hidden="true" tabindex="-1">
                                    {%- if video_src_phone != video_src_desktop -%}
                                        <source src="{{ video_src_desktop }}" type="video/mp4" media="(min-width: 641px)">
                                        <source src="{{ video_src_phone }}" type="video/mp4">
                                    {%- else -%}
                                        <source src="{{ video_src_desktop }}" type="video/mp4">
                                    {%- endif -%}
                                </video>
                            </div>
                        {%- endif -%}

                        {%- capture slide_content -%}
                            {%- if block.settings.title != blank -%}
                                <h2 class="slideshow__title heading h1">{{ block.settings.title | escape }}</h2>
                            {%- endif -%}

                            {%- if block.settings.content != blank -%}
                                <p class="slideshow__content">{{ block.settings.content | escape | newline_to_br }}</p>
                            {%- endif -%}

                            {%- if block.settings.link != blank and block.settings.button_text != blank -%}
                                <a href="{{ block.settings.link }}"
                                   class="slideshow__button button">{{ block.settings.button_text | escape }}</a>
                            {%- endif -%}
                        {%- endcapture -%}

                        {%- if slide_content != blank -%}
                            <div class="slideshow__content-wrapper">
                                <div class="container">
                                    {{ slide_content }}
                                </div>
                            </div>
                        {%- endif -%}
                    </div>

                    <style>
                        #block-{{ block.id }} {
                            color: {{ block.settings.text_color }};
                        }

                        {% if section.settings.redondo %}
                        @media screen and (min-width: 1280px) {
                            #block-{{ block.id }} .slideshow__image {
                                border-radius: 10px;
                            }
                        }

                        {% endif %}

                        {% if section.settings.active_zoom %}
                        #block-{{ block.id }} .slideshow__image {
                            transition: transform 9.5s ease, transform-origin 9.5s ease, transform-style 9.5s ease;
                            transform-origin: center center;
                            transform-style: preserve-3d;
                        }

                        #block-{{ block.id }} .slideshow__image:hover {
                            transform: scale(1.1);
                        }

                        {% endif %}

                        {%- if use_video and section.settings.section_size == 'preserve_ratio' -%}
                        #block-{{ block.id }} .slideshow__video-wrapper {
                            padding-bottom: {{ 100.0 | divided_by: video_ratio_desktop }}%;
                        }

                        @media screen and (max-width: 640px) {
                            #block-{{ block.id }} .slideshow__video-wrapper {
                                padding-bottom: {{ 100.0 | divided_by: video_ratio_phone }}%;
                            }
                        }

                        {%- endif -%}

                        #block-{{ block.id }} .button {
                            color: {{ block.settings.button_text_color }};
                            background: {{ block.settings.button_background }};
                        }

                        #block-{{ block.id }} .button:hover {
                            background: {{ block.settings.button_background | color_modify: 'alpha', 0.8 }};
                        }

                        {%- if block.settings.show_overlay -%}
                        #block-{{ block.id }}.slideshow__slide--overlay::before {
                        {%- assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0 -%} background: linear-gradient(to bottom, rgba(0, 0, 0, 0), {{ '#000000' | color_modify: 'alpha', overlay_opacity }});
                        }

                        {%- endif -%}
                    </style>

                    {%- if block.settings.image and section.settings.section_size != 'preserve_ratio' and use_video == false -%}
                        <noscript>
                            <style>
                                #block-{{ block.id }} .slideshow__slide-inner {
                                    background-image: url({{ block.settings.image | img_url: '1400x' }})
                                }
                            </style>
                        </noscript>
                    {%- endif -%}
                {%- endcapture -%}

                {%- if block.settings.link != blank and block.settings.button_text == blank -%}
                    <a href="{{ block.settings.link }}"
                       class="slideshow__slide {% if block.settings.show_overlay %}slideshow__slide--overlay{% endif %} {% if forloop.first %}is-selected{% endif %}"
                       id="block-{{ block.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                        {{- slide_inner -}}
                    </a>
                {%- else -%}
                    <div class="slideshow__slide {% if block.settings.show_overlay %}slideshow__slide--overlay{% endif %} {% if forloop.first %}is-selected{% endif %}"
                         id="block-{{ block.id }}"
                         data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                        {{- slide_inner -}}
                    </div>
                {%- endif -%}
            {%- endfor -%}
        </div>
    </div>
</section>

{%- if section_has_video -%}
    <style>
        #shopify-section-{{ section.id }} .slideshow__video-wrapper {
            overflow: hidden;
        }

        #shopify-section-{{ section.id }} .slideshow__video-wrapper--fill {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        #shopify-section-{{ section.id }} .slideshow__video-wrapper .slideshow__video,
        #shopify-section-{{ section.id }} .slideshow__video-wrapper .slideshow__video-fallback {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            max-width: 100%;
            max-height: 100%;
            -o-object-fit: cover;
            object-fit: cover;
            -o-object-position: center;
            object-position: center;
        }

        #shopify-section-{{ section.id }} .slideshow__video.is-unavailable {
            display: none;
        }
    </style>

    <script>
        (function () {
            var videos = document.querySelectorAll('#shopify-section-{{ section.id }} .slideshow__video');
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            Array.prototype.forEach.call(videos, function (video) {
                /* Esconde o vídeo e deixa a imagem de fallback (que está logo abaixo) visível */
                var showFallback = function () {
                    video.pause();
                    video.classList.add('is-unavailable');
                };

                if (reduceMotion) {
                    showFallback();
                    return;
                }

                var sources = video.querySelectorAll('source');
                if (sources.length) {
                    sources[sources.length - 1].addEventListener('error', showFallback);
                }
                video.addEventListener('error', showFallback);

                var attempt = video.play();
                if (attempt && typeof attempt.catch === 'function') {
                    attempt.catch(function (error) {
                        if (!error || error.name !== 'AbortError') {
                            showFallback();
                        }
                    });
                }
            });
        })();
    </script>
{%- endif -%}

{% if section.settings.slideduvidas %}
    <style>
        #shopify-section-{{ section.id }} .flickity-page-dots {
            display: none;
        }

        @media (min-width: 768px) {
          #shopify-section-{{ section.id }} {
             margin-bottom: -41px;
          }
        }
    </style>
{% endif %}

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 6,
  "settings": [
{
"type":"checkbox",
"id":"removeLazyLoad",
"label":"improve FCP",
"info": "remove lazyload from first image",
"default":false
},
    {
      "type": "checkbox",
      "id": "edge_to_edge",
      "label": "Full-width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "redondo",
      "label": "Slider arredondado",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "active_zoom",
      "label": "Slider com zoom",
      "default": true
    },
    {
      "type": "select",
      "id": "section_size",
      "label": "Image size",
      "options": [
        {
          "value": "preserve_ratio",
          "label": "Original image ratio"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "preserve_ratio"
    },
    {
      "type": "select",
      "id": "carousel_effect",
      "label": "Transition effect",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "default": "slide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "slideduvidas",
      "label": "Slide de dúvidas",
      "default": false
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Mídia do banner"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Tipo de mídia",
          "options": [
            {
              "value": "image",
              "label": "Imagem"
            },
            {
              "value": "video",
              "label": "Vídeo"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1800 x 600px .jpg recommended",
          "visible_if": "{{ block.settings.media_type != 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "750 x 1100px .jpg recommended. If none is set, desktop image will be used.",
          "visible_if": "{{ block.settings.media_type != 'video' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Vídeo",
          "info": "MP4 enviado para Shopify. Toca automaticamente, sem som, em loop e sem controles. O banner segue a proporção do vídeo (ex.: 1800 x 600px para a mesma altura da imagem atual).",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Vídeo para celular (opcional)",
          "info": "Recomendado vídeo vertical (ex.: 750 x 1100px). Se não for definido, o vídeo acima será usado no celular.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "video_fallback_image",
          "label": "Imagem de fallback do vídeo",
          "info": "Aparece enquanto o vídeo carrega e sempre que o vídeo não puder ser reproduzido. Se vazia, é usada a capa gerada pela Shopify.",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "header",
          "content": "Conteúdo"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show overlay",
          "info": "Increase text readability on busy images.",
          "default": false
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Slide title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "Tell your story"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "info": "On mobile, content is always centered.",
          "options": [
            {
              "value": "top_left",
              "label": "Top left"
            },
            {
              "value": "top_center",
              "label": "Top center"
            },
            {
              "value": "top_right",
              "label": "Top right"
            },
            {
              "value": "middle_left",
              "label": "Middle left"
            },
            {
              "value": "middle_center",
              "label": "Middle center"
            },
            {
              "value": "middle_right",
              "label": "Middle right"
            },
            {
              "value": "bottom_left",
              "label": "Bottom left"
            },
            {
              "value": "bottom_center",
              "label": "Bottom center"
            },
            {
              "value": "bottom_right",
              "label": "Bottom right"
            }
          ],
          "default": "middle_center"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Text",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Text",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
